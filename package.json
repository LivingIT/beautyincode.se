{
  "name": "bic-2026",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite dev",
    "prepare": "svelte-kit sync && git config core.hooksPath .githooks",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "remark . --ignore-path .gitignore --ignore-pattern .claude/skills --frail --quiet --no-stdout && prettier --check . && eslint ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@iconify/svelte": "5.2.3",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/eslint": "9.6.1",
    "@types/gtag.js": "0.0.20",
    "@types/node": "25.9.9",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "mdsvex": "0.12.8",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "3.5.2",
    "remark-cli": "12.0.1",
    "remark-validate-links": "13.1.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "wrangler": "4.152.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<0.28.1": "0.28.2",
      "undici@<7.29.0": "7.30.1",
      "cookie@<0.7.0": "0.7.2"
    }
  }
}
