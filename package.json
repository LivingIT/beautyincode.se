{
  "name": "bic-2026",
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite dev",
    "prepare": "svelte-kit sync && git config core.hooksPath .githooks",
    "build": "PUBLIC_DEPLOY_TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ) vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "remark . --ignore-path .gitignore --ignore-pattern .claude/skills --frail --quiet --no-stdout && prettier --check . && eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@iconify/svelte": "5.2.3",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-cloudflare": "8.0.1",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/eslint": "9.6.1",
    "@types/gtag.js": "0.0.20",
    "@types/node": "25.9.9",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "mdsvex": "0.12.8",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "3.5.2",
    "remark-cli": "12.0.1",
    "remark-validate-links": "13.1.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<0.28.1": "0.28.2",
      "undici@<7.29.0": "7.30.1",
      "cookie@<0.7.0": "0.7.2"
    }
  }
}
